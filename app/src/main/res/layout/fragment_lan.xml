<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp">

        <!-- ================================================================
             HEADER SECTION
             Shows "NETWORK SCANNER" label + "LAN Guard" title
             Matches the visual style of the WiFi fragment header
        ================================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Small gold label above the title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NETWORK SCANNER"
                    android:textColor="@color/accent_gold"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"/>

                <!-- Main page title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAN Guard"
                    android:textColor="@color/text_dark"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ================================================================
             STATUS CARD
             Dark card showing scan status + device count.
             Mirrors the "Connected Network" card in the WiFi fragment.
        ================================================================ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Static label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCAN STATUS"
                    android:textColor="#80F8F4E1"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"/>

                <!-- Dynamic scan status message — updated from Fragment -->
                <TextView
                    android:id="@+id/tv_scan_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready to scan"
                    android:textColor="@color/text_light"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"/>

                <!-- Device count label -->
                <TextView
                    android:id="@+id/tv_device_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 devices found"
                    android:textColor="#80F8F4E1"
                    android:textSize="13sp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ================================================================
             PROGRESS SECTION
             Horizontal progress bar + "X / 254" label.
             Hidden until a scan starts (View.GONE → View.VISIBLE).
        ================================================================ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Row: "PROGRESS" label on left, "X / 254" on right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SCAN PROGRESS"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"/>

                    <!-- Updated by Fragment: "45 / 254" -->
                    <TextView
                        android:id="@+id/tv_progress_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 254"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"/>

                </LinearLayout>

                <!-- The progress bar itself — same style as WiFi fragment -->
                <ProgressBar
                    android:id="@+id/progress_scan"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_risk_bar"
                    android:background="@drawable/bg_progress_track"
                    android:visibility="gone"/>
                <!--
                    visibility="gone" = hidden AND takes no space.
                    The Fragment sets this to VISIBLE when scanning starts.
                -->

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ================================================================
             DEVICE LIST HEADER
             Shows "DETECTED DEVICES" label above the RecyclerView
        ================================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="DETECTED DEVICES"
            android:textColor="@color/accent_gold"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:textStyle="bold"/>

        <!-- ================================================================
             RECYCLERVIEW — The Device List
             This is just a container. The Adapter fills it with cards.
             nestedScrollingEnabled="false" is needed because RecyclerView is
             inside a ScrollView — disabling its own scrolling lets the
             parent ScrollView handle all scrolling seamlessly.
        ================================================================ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false"
            android:paddingBottom="8dp"/>

        <!-- ================================================================
             SCAN BUTTON
             Matches the style of the WiFi fragment's "Deep Scan" button.
             Text toggles between "Scan Network" / "Stop Scan" / "Scan Again".
        ================================================================ -->
        <Button
            android:id="@+id/btn_scan_lan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="Scan Network"
            android:textColor="@color/text_light"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:backgroundTint="@color/card_dark"
            android:stateListAnimator="@null"
            android:elevation="6dp"/>

    </LinearLayout>

</ScrollView>