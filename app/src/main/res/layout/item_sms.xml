<?xml version="1.0" encoding="utf-8"?>
<!--
    item_sms.xml — Single SMS Card (Expandable)

    COLLAPSED view (always visible):
      [ Risk badge ]  Sender name
                      Message preview (120 chars)
                      Date & time          [ ▼ ]

    EXPANDED view (tap card to toggle):
      ─────────────────────────────────
      Full message body
      Matched keywords: lottery, click link
      Explanation: Likely phishing — lottery scams...
      Risk Score: 85 / 100
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_sms"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ================================================================
             COLLAPSED ROW — always visible
        ================================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left: Risk badge pill -->
            <!-- ID: tv_sms_risk_badge — Java sets text + color -->
            <TextView
                android:id="@+id/tv_sms_risk_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Safe"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_badge_risk"
                android:layout_marginEnd="10dp"/>

            <!-- Centre: Sender + Preview stacked vertically -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- ID: tv_sms_sender -->
                <TextView
                    android:id="@+id/tv_sms_sender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VM-HDFCBK"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <!-- ID: tv_sms_body_preview -->
                <TextView
                    android:id="@+id/tv_sms_body_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Message preview here..."
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <!-- ID: tv_sms_timestamp -->
                <TextView
                    android:id="@+id/tv_sms_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24 Mar 2026, 10:45 AM"
                    android:textColor="#BBBBBB"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <!-- Right: Expand arrow ▼ / ▲ -->
            <!-- ID: tv_expand_arrow — Java toggles ▼ and ▲ -->
            <TextView
                android:id="@+id/tv_expand_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

        <!-- ================================================================
             EXPANDED SECTION — hidden by default, shown on tap
             ID: layout_sms_expanded — Java toggles VISIBLE/GONE
        ================================================================ -->
        <LinearLayout
            android:id="@+id/layout_sms_expanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>

            <!-- Full body label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FULL MESSAGE"
                android:textColor="@color/accent_gold"
                android:textSize="10sp"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <!-- ID: tv_sms_full_body — Java sets full message text -->
            <TextView
                android:id="@+id/tv_sms_full_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full message body here..."
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.5"
                android:background="@drawable/bg_progress_track"
                android:padding="10dp"
                android:layout_marginBottom="10dp"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="8dp"/>

            <!-- ID: tv_sms_keywords — Java sets "Matched: lottery, otp" -->
            <TextView
                android:id="@+id/tv_sms_keywords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Matched: none"
                android:textColor="#8B6914"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <!-- ID: tv_sms_explanation — Java sets the explanation text -->
            <TextView
                android:id="@+id/tv_sms_explanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No phishing indicators found."
                android:textColor="#666666"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="8dp"/>

            <!-- ID: tv_sms_risk_score — Java sets "Risk Score: 85 / 100" in red/green -->
            <TextView
                android:id="@+id/tv_sms_risk_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Risk Score: 0 / 100"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/safe_green"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>