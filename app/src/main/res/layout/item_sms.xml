<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_sms"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- COLLAPSED ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_sms_risk_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Safe"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_badge_risk"
                android:layout_marginEnd="10dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sms_sender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sender"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_sms_body_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Message preview..."
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tv_sms_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date/Time"
                    android:textColor="#BBBBBB"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_expand_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

        <!-- EXPANDED SECTION -->
        <LinearLayout
            android:id="@+id/layout_sms_expanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FULL MESSAGE"
                android:textColor="@color/accent_gold"
                android:textSize="10sp"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <!-- Added background color directly and removed rounded track to prevent text clipping -->
            <TextView
                android:id="@+id/tv_sms_full_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full message body..."
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2"
                android:background="#F5F5F5"
                android:padding="12dp"
                android:layout_marginBottom="10dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_sms_keywords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Matched: none"
                android:textColor="#8B6914"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tv_sms_explanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explanation here..."
                android:textColor="#666666"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_sms_risk_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Risk Score: 0 / 100"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/safe_green"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>