<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_device"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <!--
        Horizontal LinearLayout:
        [ ● dot ]  [ IP / MAC / Vendor / Hostname ]  [ BADGE ]
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- ====================================================
             ONLINE INDICATOR DOT
             A colored bullet (●) — green if online, gray if not.
             Small fixed-width column on the left.
        ==================================================== -->
        <TextView
            android:id="@+id/tv_online_indicator"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:text="●"
            android:textSize="18sp"
            android:textColor="@color/safe_green"
            android:gravity="center"/>

        <!-- ====================================================
             DEVICE INFO COLUMN
             Stacked vertically: IP address (large) + MAC + Vendor + Hostname
             layout_weight="1" makes this column take all remaining space
        ==================================================== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp">

            <!-- IP Address — largest text, most important -->
            <TextView
                android:id="@+id/tv_device_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="192.168.1.1"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- Hostname — only shown if available (GONE otherwise) -->
            <TextView
                android:id="@+id/tv_device_hostname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="johns-iphone.local"
                android:textColor="@color/text_dark"
                android:textSize="12sp"
                android:layout_marginTop="1dp"
                android:visibility="gone"/>
            <!--
                visibility="gone" = hidden by default.
                The Adapter sets this VISIBLE only if a hostname was resolved.
            -->

            <!-- MAC Address row -->
            <TextView
                android:id="@+id/tv_device_mac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A4:C3:F0:12:34:56"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"/>
            <!--
                fontFamily="monospace" makes MAC addresses aligned and easy to read
                since all characters are the same width.
            -->

            <!-- Vendor Name (Apple Inc., Samsung, etc.) -->
            <TextView
                android:id="@+id/tv_device_vendor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apple Inc."
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginTop="1dp"/>

        </LinearLayout>

        <!-- ====================================================
             STATUS BADGE
             Small rounded pill on the right showing:
               "YOU"    → blue   (this device)
               "ROUTER" → gold   (gateway)
               "DEVICE" → brown  (unknown device)
             Colors are set programmatically in the Adapter.
        ==================================================== -->
        <TextView
            android:id="@+id/tv_device_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVICE"
            android:textColor="@color/text_dark"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/bg_badge_risk"/>
        <!--
            Reusing bg_badge_risk drawable from the WiFi module for the
            rounded pill background. The Adapter overrides the background
            color programmatically for different device types.
        -->

    </LinearLayout>

</androidx.cardview.widget.CardView>