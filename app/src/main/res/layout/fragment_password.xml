<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp">

        <!-- ================================================================
             PAGE HEADER
             Matches visual style of WiFi and LAN fragment headers.
        ================================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SECURITY TOOLS"
                    android:textColor="@color/accent_gold"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password Toolkit"
                    android:textColor="@color/text_dark"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ================================================================
             SECTION LABEL: "Test Strength"
        ================================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="10dp"
            android:text="Test Strength"
            android:textColor="@color/text_dark"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <!-- ================================================================
             STRENGTH CHECKER CARD
             Contains: password input + toggle + strength bar + feedback
        ================================================================ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- "Enter Password" hint label above the input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter Password"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>

                <!-- Password Input Row: [EditText] [Eye Button] -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_progress_track"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <!--
                        THE PASSWORD INPUT FIELD
                        ID: et_password
                        Java connects here for TextWatcher + InputType changes

                        inputType="textPassword" = shows dots by default
                        layout_weight="1"        = takes all remaining width
                    -->
                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="textPassword"
                        android:background="@null"
                        android:textSize="18sp"
                        android:textColor="@color/text_dark"
                        android:hint="Type your password..."
                        android:textColorHint="#CCCCCC"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"/>

                    <!--
                        THE EYE TOGGLE BUTTON
                        ID: btn_toggle_password
                        Java connects here to toggle password visibility

                        Uses built-in Android drawable for now.
                        Dhairyashil: replace with a custom eye icon drawable.
                    -->
                    <ImageButton
                        android:id="@+id/btn_toggle_password"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_secure"
                        android:background="@null"
                        android:contentDescription="Toggle password visibility"
                        android:padding="8dp"/>

                </LinearLayout>

                <!-- Divider line under the input -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Strength Row: "Strength" label on left, "Strong" value on right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Strength"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <!--
                        STRENGTH LABEL (e.g. "Strong", "Weak")
                        ID: tv_strength_label
                        Java updates: text + textColor based on score
                    -->
                    <TextView
                        android:id="@+id/tv_strength_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!--
                    STRENGTH PROGRESS BAR
                    ID: progress_strength
                    Java updates: progress (0–100) + color tinting

                    max="100" = our score goes from 0 to 100
                    progress="0" = starts empty
                    Dhairyashil: replace progressDrawable with a custom
                    rounded drawable matching the mockup's green bar style.
                -->
                <ProgressBar
                    android:id="@+id/progress_strength"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_risk_bar"
                    android:background="@drawable/bg_progress_track"
                    android:layout_marginBottom="12dp"/>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"
                    android:layout_marginBottom="10dp"/>

                <!--
                    FEEDBACK MESSAGE (e.g. "Good job! This is a secure password.")
                    ID: tv_feedback_message
                    Java updates: text content
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡"
                        android:textSize="16sp"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tv_feedback_message"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Enter a password to check its strength."
                        android:textColor="#888888"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4"/>

                </LinearLayout>

                <!-- ============================================================
                     IMPROVEMENT TIPS SECTION
                     Only visible when the password has room to improve.
                     Java shows/hides this section and fills it with tip TextViews.
                ============================================================ -->

                <!--
                    TIPS HEADER
                    ID: tv_tips_header
                    Java toggles: VISIBLE when there are tips, GONE when password is strong
                -->
                <TextView
                    android:id="@+id/tv_tips_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Improvement Tips:"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone"/>

                <!--
                    TIPS CONTAINER
                    ID: layout_tips
                    Java calls: layoutTips.removeAllViews() then adds TextViews
                    dynamically — one per improvement tip.
                    Visibility toggled by Java: VISIBLE or GONE
                -->
                <LinearLayout
                    android:id="@+id/layout_tips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ================================================================
             GENERATOR SECTION PLACEHOLDER
             (To be implemented in the next phase)
        ================================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="Generator"
            android:textColor="@color/text_dark"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:text="Password Generator coming soon..."
                android:textColor="#AAAAAA"
                android:textSize="14sp"/>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>