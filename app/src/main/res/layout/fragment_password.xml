<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SECURITY TOOLS"
                    android:textColor="@color/accent_gold"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password Toolkit"
                    android:textColor="@color/text_dark"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="10dp"
            android:text="Test Strength"
            android:textColor="@color/text_dark"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter Password"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>

                <!-- Password input + eye toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_progress_track"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <!-- ID: et_password — Java reads text and changes inputType here -->
                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="textPassword"
                        android:background="@null"
                        android:textSize="18sp"
                        android:textColor="@color/text_dark"
                        android:hint="Type your password..."
                        android:textColorHint="#CCCCCC"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"/>

                    <!-- ID: btn_toggle_password — Java toggles show/hide here -->
                    <ImageButton
                        android:id="@+id/btn_toggle_password"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_secure"
                        android:background="@null"
                        android:contentDescription="Toggle password visibility"
                        android:padding="8dp"/>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Strength label row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Strength"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <!-- ID: tv_strength_label — Java sets text and color here -->
                    <TextView
                        android:id="@+id/tv_strength_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!-- ID: progress_strength — Java sets progress (0–100) and color here -->
                <ProgressBar
                    android:id="@+id/progress_strength"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_risk_bar"
                    android:background="@drawable/bg_progress_track"
                    android:layout_marginBottom="12dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"
                    android:layout_marginBottom="10dp"/>

                <!-- Feedback row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡"
                        android:textSize="16sp"
                        android:layout_marginEnd="8dp"/>

                    <!-- ID: tv_feedback_message — Java sets text here -->
                    <TextView
                        android:id="@+id/tv_feedback_message"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Enter a password to check its strength."
                        android:textColor="#888888"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4"/>

                </LinearLayout>

                <!-- ID: tv_tips_header — Java shows/hides this -->
                <TextView
                    android:id="@+id/tv_tips_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Improvement Tips:"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone"/>

                <!-- ID: layout_tips — Java adds/removes tip TextViews inside here -->
                <LinearLayout
                    android:id="@+id/layout_tips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Generator"
                android:textColor="@color/text_dark"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <!-- ID: tv_reset_defaults — Java sets click listener here -->
            <TextView
                android:id="@+id/tv_reset_defaults"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset defaults"
                android:textColor="@color/accent_gold"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="4dp"/>

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Generated password display box + copy button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_progress_track"
                    android:padding="14dp"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GENERATED PASSWORD"
                            android:textColor="@color/accent_gold"
                            android:textSize="10sp"
                            android:letterSpacing="0.08"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:id="@+id/tv_generated_password"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap Generate to create a password"
                            android:textColor="@color/text_dark"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"/>

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btn_copy_password"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_menu_copybtn"
                        android:backgroundTint="@null"
                        android:contentDescription="Copy password"
                        android:padding="10dp"/>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"
                    android:layout_marginBottom="16dp"/>

                <!-- Length row: "Length" label + current value number -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Length"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_length_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12"
                        android:textColor="@color/accent_gold"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekbar_length"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:progressTint="@color/card_dark"
                    android:thumbTint="@color/card_dark"/>

                <!-- Min / Max labels under the slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="6"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="32"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"/>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <!-- Uppercase checkbox -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_progress_track"
                        android:padding="12dp"
                        android:layout_marginEnd="6dp">

                        <CheckBox
                            android:id="@+id/cb_uppercase"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:buttonTint="@color/card_dark"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Uppercase"
                            android:textColor="@color/text_dark"
                            android:textSize="13sp"
                            android:layout_marginStart="6dp"/>

                    </LinearLayout>

                    <!-- Lowercase checkbox -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_progress_track"
                        android:padding="12dp"
                        android:layout_marginStart="6dp">

                        <CheckBox
                            android:id="@+id/cb_lowercase"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:buttonTint="@color/card_dark"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lowercase"
                            android:textColor="@color/text_dark"
                            android:textSize="13sp"
                            android:layout_marginStart="6dp"/>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="18dp">

                    <!-- Numbers checkbox -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_progress_track"
                        android:padding="12dp"
                        android:layout_marginEnd="6dp">

                        <CheckBox
                            android:id="@+id/cb_numbers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:buttonTint="@color/card_dark"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Numbers"
                            android:textColor="@color/text_dark"
                            android:textSize="13sp"
                            android:layout_marginStart="6dp"/>

                    </LinearLayout>

                    <!-- Symbols checkbox -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_progress_track"
                        android:padding="12dp"
                        android:layout_marginStart="6dp">

                        <CheckBox
                            android:id="@+id/cb_symbols"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:buttonTint="@color/card_dark"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Symbols"
                            android:textColor="@color/text_dark"
                            android:textSize="13sp"
                            android:layout_marginStart="6dp"/>

                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/btn_generate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="⟳  Generate New Password"
                    android:textColor="@color/text_light"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/card_dark"
                    android:stateListAnimator="@null"
                    android:elevation="4dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>